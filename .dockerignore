# 构建上下文排除：只保留源码与 web/ 资源
# Build-context exclusions: keep only sources and web/ assets
.git
.gitignore
.github/
.git/info/
video/
docs/
dist-newstyle/
*.o
*.hi
*.dyn_o
*.dyn_hi
*.p_o
*.p_hi
*.hie
/main
/main.exe
/extension
/extension.exe
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.workbuddy/
.openchamber/
out/
node_modules/
# 运行时状态文件：由服务在运行时生成，不能烘进镜像
# Runtime state: created by the service at runtime, never baked into the image
web/shares.json
web/shares.json.tmp
web/sessions.json
web/sessions.json.tmp
web/tokens.json
web/tokens.json.tmp
web/sharepages.json
web/sharepages.json.tmp
web/benchmarks.json
web/benchmarks.json.tmp
web/*.sqlite
web/*.sqlite.tmp
web/*.db
web/*.db.tmp
