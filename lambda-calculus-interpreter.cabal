cabal-version:      3.0
name:               lambda-calculus-interpreter
version:            2.2.2
synopsis:           Pure lambda calculus interpreter with traces and a web UI
description:
  Two standalone executables: a minimal REPL and an extended REPL with
  definitions, types, reduction traces, redex picking and a batch/JSON mode.
license:            MIT
license-file:       LICENSE
author:             lambda-calculus-interpreter contributors
maintainer:         none
build-type:         Simple
extra-source-files: README.md
                    README-CN.md
                    CHANGELOG.md
                    CONTRIBUTING.md
                    AGENTS.md
                    Dockerfile
                    VERSION
                    test.lam
                    lib/prelude.lam
                    desktop.py
                    desktop-requirements.txt

executable main
  main-is:          main.hs
  hs-source-dirs:   .
  build-depends:    base >=4.16 && <5
                  , containers
                  , directory
                  , haskeline
                  , process
  default-language: Haskell2010
  ghc-options:      -O2 -Wall -threaded -rtsopts

executable extension
  main-is:          extension.hs
  hs-source-dirs:   .
  build-depends:    base >=4.16 && <5
                  , containers
                  , directory
                  , haskeline
                  , process
  default-language: Haskell2010
  ghc-options:      -O2 -Wall -threaded -rtsopts
